# ─── Browser-exposed (Vite, prefix VITE_) ────────────────────────────────────
# These reach the user's browser. Use the Supabase ANON key only — never the service-role key.
# Find them at: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="ey...your-anon-public-key..."

# ─── Server-only ─────────────────────────────────────────────────────────────
# Same URL as above, but the server can additionally use a service-role key for admin ops
# (auto-seed in dev, scoring writes, soft-deletes that bypass RLS).
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="ey...your-anon-public-key..."
# OPTIONAL — leave empty to use the anon key only. Required if you want server endpoints to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Authorization & admin ───────────────────────────────────────────────────
# Comma-separated list of admin emails (lowercase). Admins can run /api/db/reset, score predictions,
# upsert matches, see the simulator panel, and delete arbitrary groups.
ADMIN_EMAILS="dartanhan.fett@gmail.com"
# DEPRECATED — não é mais usado pelo /api/db/reset (a UI da web já tem sua própria confirmação).
# Pode deixar vazio ou remover. Mantido aqui apenas por compatibilidade com .env existentes.
RESET_CONFIRMATION_TOKEN=""

# ─── External integrations ───────────────────────────────────────────────────
# Optional — enables the "IA sugere placar" button on each match. Without it the
# button still works but uses canned random fallback text. Get a key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional override — defaults to "gemini-2.5-flash". Use "gemini-2.5-flash-lite" for cheaper/faster.
# GEMINI_MODEL="gemini-2.5-flash"

# Optional — enables real fixture data from API-Football (api-sports.io). Without it the app uses INITIAL_MATCHES.
FOOTBALL_API_KEY=""

# ─── Deployment ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS. Use "*" for development only.
CORS_ORIGIN="*"
# Set to "production" when deploying. Disables auto-seed and stricter error messages.
NODE_ENV="development"
