# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FOOTBALL_API_KEY: Optional key for API-Football (api-sports.io).
# Set this key via the Secrets panel in the AI Studio UI to load real live matches.
FOOTBALL_API_KEY="MY_FOOTBALL_API_KEY"

# SUPABASE_URL: The API URL endpoint of your Supabase project (e.g. https://xxxxxx.supabase.co).
# Get this from your Supabase Dashboard under Project Settings > API.
SUPABASE_URL=""

# SUPABASE_ANON_KEY: The public anonymous API key of your Supabase project.
# Get this from your Supabase Dashboard under Project Settings > API.
SUPABASE_ANON_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_MODEL: The Gemini model used for text and analysis.
# Default is "gemini-3.5-flash". For a cheaper, light-weight option, use "gemini-3.1-flash-lite".
GEMINI_MODEL="gemini-3.5-flash"

